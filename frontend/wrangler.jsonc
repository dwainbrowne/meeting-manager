{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meeting-manager-frontend",
  "main": "worker.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "meeting-manager-api-staging"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "meeting-manager-frontend-staging",
      "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"]
      },
      "services": [
        {
          "binding": "API",
          "service": "meeting-manager-api-staging"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    },
    "production": {
      "name": "meeting-manager-frontend-production",
      "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"]
      },
      "services": [
        {
          "binding": "API",
          "service": "meeting-manager-api-production"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      }
    }
  }
}
